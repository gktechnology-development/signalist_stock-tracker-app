# MongoDB - Get from https://cloud.mongodb.com (create a free cluster)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=

# Better Auth - Generate a random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Finnhub - Get from https://finnhub.io/register
NEXT_PUBLIC_FINNHUB_API_KEY=
FINNHUB_API_KEY=

# Gemini AI - Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Nodemailer (Gmail) - Use an App Password from https://myaccount.google.com/apppasswords
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=

# Inngest (optional for local dev)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
